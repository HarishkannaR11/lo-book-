# Supabase project → Settings → API. Local values are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by scripts/verify-rls.ts to delete its test users. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Postgres connection string for `npm run db:migrate` against the hosted project.
SUPABASE_DB_URL=
