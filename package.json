{
  "name": "lorry-book",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm test",
    "icons": "node scripts/make-icons.mjs",
    "db:start": "SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=${SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID:-local} SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=${SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID:-local} SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=${SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN:-local} supabase start -x realtime,imgproxy,mailpit,studio,edge-runtime,logflare,vector,supavisor",
    "db:reset": "SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=${SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID:-local} SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=${SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID:-local} SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=${SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN:-local} supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "db:migrate": "bash scripts/db-migrate.sh",
    "verify:rls": "tsx --env-file=.env.local scripts/verify-rls.ts",
    "db:stop": "supabase stop",
    "postinstall": "node scripts/copy-tesseract.mjs",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
